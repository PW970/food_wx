/* pages/profile/profile.wxss */

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.user-card {
  padding: 30rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 237, 223, 0.9), transparent 34%),
    rgba(255, 253, 249, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 48rpx rgba(73, 52, 35, 0.08);
  margin-bottom: 24rpx;
}

.user-top {
  display: flex;
  align-items: center;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 22rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.7);
}

.info .name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2520;
}

.info .uid {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f9688;
}

.profile-note {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #667063;
}

.login-row {
  margin-top: 24rpx;
}

.login-btn {
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #dd6b2f, #f08d49);
  color: #fffdf9;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-error {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #c95f2a;
}

.auth-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 239, 0.92);
  border: 1rpx solid rgba(201, 95, 42, 0.12);
}

.auth-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2520;
}

.auth-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #667063;
}

.avatar-picker {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 22rpx;
  background: #fffdf9;
  border: none;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #f3eee6;
}

.avatar-copy {
  font-size: 26rpx;
  color: #1f2520;
}

.nickname-input {
  margin-top: 18rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  color: #1f2520;
  font-size: 28rpx;
  box-sizing: border-box;
}

.auth-submit {
  margin-top: 18rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #1f8f55;
  color: #fffdf9;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.auth-submit::after {
  border: none;
}

.section-head {
  margin: 30rpx 6rpx 18rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2520;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f9688;
}

.menu {
  background: rgba(255, 253, 249, 0.92);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 48rpx rgba(73, 52, 35, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(31, 37, 32, 0.06);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #fff1e8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.icon-wrap.alt {
  background: #f7f3ec;
}

.icon {
  font-size: 32rpx;
  color: #c95f2a;
}

.menu-copy {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 29rpx;
  color: #1f2520;
  font-weight: 600;
}

.desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8f9688;
}

.arrow {
  font-size: 32rpx;
  color: #c8cec3;
}
