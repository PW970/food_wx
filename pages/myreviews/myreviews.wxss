/* pages/myreviews/myreviews.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #98a090;
}

.spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  margin: 0 auto 16rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.list {
  height: calc(100vh - 48rpx);
  padding-bottom: 10rpx;
  box-sizing: border-box;
}

.item {
  background: rgba(255, 253, 249, 0.92);
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 16rpx 40rpx rgba(73, 52, 35, 0.08);
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2520;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rating {
  color: #dd8a1f;
  font-size: 24rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff6df;
}

.rating .star {
  margin-left: 2rpx;
}

.content {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #667063;
  line-height: 42rpx;
}

.review-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.shop-cover {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #ece5db;
}

.review-author {
  font-size: 23rpx;
  color: #98a090;
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.time {
  font-size: 22rpx;
  color: #98a090;
}

.delete-btn {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #c95f2a;
  font-size: 22rpx;
}
