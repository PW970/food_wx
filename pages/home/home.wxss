/* pages/home/home.wxss - 首页样式 */

.home-container {
  min-height: 100vh;
  padding: 32rpx 24rpx 40rpx;
}

.hero {
  margin-bottom: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 237, 223, 0.95), transparent 34%),
    linear-gradient(160deg, rgba(255, 252, 247, 0.96) 0%, rgba(247, 241, 232, 0.92) 100%);
  box-shadow: 0 24rpx 60rpx rgba(77, 59, 41, 0.08);
  overflow: hidden;
}

.hero-badge {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(221, 107, 47, 0.1);
  color: #c65d28;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 50rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1f2520;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6a7267;
}

.hero-actions {
  margin-top: 24rpx;
}

.map-entry {
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(31, 37, 32, 0.04);
  border: 1rpx solid rgba(31, 37, 32, 0.06);
}

.map-entry-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2520;
}

.map-entry-subtext {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8f9688;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 14rpx 14rpx 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.92);
  border: 1rpx solid rgba(31, 37, 32, 0.06);
}

.search-icon {
  margin-right: 14rpx;
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #8f9688;
}

.search-action {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #1f2520;
  color: #fff;
  font-size: 24rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #8f9688;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 100rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 249, 0.84);
  box-shadow: 0 18rpx 48rpx rgba(73, 52, 35, 0.06);
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.error-text {
  font-size: 28rpx;
  color: #667063;
  margin-bottom: 28rpx;
}

.retry-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #dd6b2f, #ef8f55);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  box-shadow: 0 16rpx 32rpx rgba(221, 107, 47, 0.22);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 110rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 249, 0.84);
  box-shadow: 0 18rpx 48rpx rgba(73, 52, 35, 0.06);
}

.empty-icon {
  font-size: 108rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #1f2520;
  font-weight: 600;
}

.empty-subtext {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8f9688;
}

.list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 8rpx 22rpx;
}

.list-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2520;
}

.list-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f9688;
}

.list-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.9);
  color: #667063;
  font-size: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(73, 52, 35, 0.05);
}

.shop-card {
  background: rgba(255, 253, 249, 0.92);
  border-radius: 30rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(73, 52, 35, 0.08);
}

.shop-cover {
  position: relative;
  width: 100%;
  height: 330rpx;
  background-color: #e9e3da;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(180deg, rgba(20, 21, 18, 0) 0%, rgba(20, 21, 18, 0.46) 100%);
}

.recommend-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 10rpx 18rpx;
  background: rgba(255, 253, 249, 0.9);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #1f2520;
  font-weight: 500;
}

.cover-meta {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  font-size: 23rpx;
}

.cover-category,
.cover-distance {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
}

.shop-info {
  padding: 24rpx 24rpx 26rpx;
}

.shop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.shop-name {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2520;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-score {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1e8;
}

.score-star {
  font-size: 24rpx;
  margin-right: 6rpx;
  color: #dd6b2f;
}

.score-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #dd6b2f;
}

.recommend-copy {
  font-size: 26rpx;
  line-height: 1.7;
  color: #667063;
}

.shop-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
  margin-bottom: 18rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f7f3ec;
}

.meta-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
  color: #98a090;
}

.meta-text {
  font-size: 23rpx;
  color: #667063;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 10rpx 16rpx;
  background-color: #fff1e8;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #c95f2a;
}
