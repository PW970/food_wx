.page {
  position: relative;
  min-height: 100vh;
  background: #f4f1ea;
}

.food-map {
  width: 100%;
  height: 100vh;
}

.map-toolbar {
  position: fixed;
  right: 24rpx;
  top: 180rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  z-index: 8;
}

.toolbar-btn {
  min-width: 112rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 20rpx;
  background: rgba(255, 253, 249, 0.95);
  color: #1f2520;
  font-size: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(73, 52, 35, 0.12);
}

.toolbar-btn.strong {
  background: #1f2520;
  color: #fff;
}

.sheet {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  height: 44vh;
  padding: 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 249, 0.96);
  box-shadow: 0 22rpx 56rpx rgba(73, 52, 35, 0.18);
  backdrop-filter: blur(16px);
  z-index: 7;
}

.sheet-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2520;
}

.sheet-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8f9688;
}

.sheet-count {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f7f3ec;
  color: #667063;
  font-size: 22rpx;
}

.state {
  padding: 60rpx 0;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 18rpx;
  border: 4rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-text {
  font-size: 26rpx;
  color: #667063;
}

.retry-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  background: #1f2520;
  color: #fff;
  font-size: 24rpx;
}

.shop-scroll {
  height: calc(44vh - 110rpx);
}

.shop-card {
  display: flex;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid transparent;
}

.shop-card.active {
  border-color: rgba(221, 107, 47, 0.45);
  box-shadow: 0 14rpx 32rpx rgba(221, 107, 47, 0.12);
}

.shop-image {
  width: 180rpx;
  height: 180rpx;
  background: #ece5db;
}

.shop-copy {
  flex: 1;
  padding: 18rpx;
}

.shop-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shop-name {
  flex: 1;
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2520;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-score {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #dd6b2f;
  font-size: 22rpx;
  font-weight: 700;
}

.shop-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #7a8578;
}

.shop-reason {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #4c564b;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f7f3ec;
  color: #7a6755;
  font-size: 21rpx;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 18rpx;
  background: #1f2520;
  color: #fff;
  font-size: 24rpx;
}

.action-btn.secondary {
  background: #f7f3ec;
  color: #1f2520;
}
