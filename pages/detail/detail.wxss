/* pages/detail/detail.wxss */

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.cover {
  position: relative;
  height: 520rpx;
  background: #eaeaea;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(15,17,14,0.72) 100%);
}

.cover-title {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 32rpx;
  color: #fff;
}

.cover-chip {
  display: inline-flex;
  margin-bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.18);
  font-size: 22rpx;
  backdrop-filter: blur(10px);
}

.shop-name {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.shop-sub {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.star {
  margin-right: 8rpx;
}

.score {
  font-weight: 600;
}

.dot {
  margin: 0 12rpx;
  opacity: 0.8;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text {
  margin-top: 18rpx;
  color: #667063;
  font-size: 28rpx;
  text-align: center;
}

.state-btn {
  margin-top: 26rpx;
  padding: 18rpx 54rpx;
  background: linear-gradient(135deg, #dd6b2f, #f08d54);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 5rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.mini-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.content {
  margin-top: -52rpx;
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 18rpx 44rpx rgba(73, 52, 35, 0.08);
}

.summary-item {
  flex: 1;
  min-width: 0;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #98a090;
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #1f2520;
  font-weight: 700;
}

.card {
  background: rgba(255, 253, 249, 0.94);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(73, 52, 35, 0.08);
  margin-bottom: 22rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(31, 37, 32, 0.06);
}

.info-row:last-of-type {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  color: #98a090;
  font-size: 24rpx;
}

.info-value {
  flex: 1;
  color: #1f2520;
  font-size: 28rpx;
  line-height: 42rpx;
}

.desc {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(31, 37, 32, 0.06);
}

.desc-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #1f2520;
}

.desc-text {
  font-size: 26rpx;
  color: #667063;
  line-height: 44rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2520;
}

.section-sub {
  font-size: 24rpx;
  color: #98a090;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #c95f2a;
  font-size: 24rpx;
  border: 1rpx solid rgba(221,107,47,0.18);
}

.reviews-state {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
}

.reviews-state-text {
  font-size: 26rpx;
  color: #98a090;
}

.reviews-empty {
  padding: 30rpx 0 10rpx;
}

.reviews-empty-text {
  font-size: 26rpx;
  color: #98a090;
}

.review-item {
  display: flex;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(31, 37, 32, 0.06);
}

.review-item:first-child {
  border-top: none;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 16rpx;
}

.review-main {
  flex: 1;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2520;
}

.rating {
  color: #dd8a1f;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.r-star {
  margin-left: 2rpx;
}

.review-content {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #667063;
  line-height: 42rpx;
}

.review-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a090;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 16rpx;
  background: rgba(255,253,249,0.96);
  backdrop-filter: blur(14px);
  border: 1rpx solid rgba(31,37,32,0.06);
  border-radius: 28rpx;
  box-shadow: 0 20rpx 48rpx rgba(73, 52, 35, 0.12);
  display: flex;
  gap: 16rpx;
  z-index: 20;
}

.btn {
  flex: 1;
  height: 86rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.collect {
  background: #f7f3ec;
  color: #c95f2a;
  border: 2rpx solid rgba(221,107,47,0.16);
}

.collect.collected {
  background: #fff1e8;
  border-color: rgba(221,107,47,0.2);
}

.review {
  background: linear-gradient(135deg, #dd6b2f, #ef8f55);
  color: #fff;
}

.bottom-safe {
  height: 40rpx;
}
