/* pages/search/search.wxss */

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 32rpx;
}

.search-shell {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 249, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(73, 52, 35, 0.08);
}

.page-head {
  margin-bottom: 24rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2520;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f9688;
}

.search-bar {
  display: flex;
  align-items: center;
}

.search-input-wrap {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  background: #f7f3ec;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.search-prefix {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
  color: #1f2520;
}

.clear {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  background: rgba(31,37,32,0.08);
  color: #667063;
  font-size: 26rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #1f2520;
  color: #fff;
  font-size: 26rpx;
  min-width: 110rpx;
  text-align: center;
}

.state {
  padding: 120rpx 30rpx;
  text-align: center;
  color: #98a090;
  font-size: 28rpx;
}

.spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid rgba(31, 37, 32, 0.08);
  border-top-color: #dd6b2f;
  border-radius: 50%;
  margin: 0 auto 16rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-text {
  color: #667063;
}

.list {
  height: calc(100vh - 262rpx);
  padding-bottom: 10rpx;
  box-sizing: border-box;
}

.card {
  display: flex;
  background: rgba(255, 253, 249, 0.92);
  border-radius: 26rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  box-shadow: 0 16rpx 40rpx rgba(73, 52, 35, 0.08);
}

.thumb {
  position: relative;
  width: 220rpx;
  height: 200rpx;
  background: #eee;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-tag {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  color: #1f2520;
}

.info {
  flex: 1;
  padding: 20rpx 20rpx 18rpx;
  display: flex;
  flex-direction: column;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2520;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-wrap {
  display: flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1e8;
}

.star {
  font-size: 22rpx;
  margin-right: 4rpx;
  color: #dd6b2f;
}

.score {
  font-size: 24rpx;
  color: #dd6b2f;
  font-weight: 700;
}

.row-mid {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667063;
}

.category {
  margin-right: 12rpx;
}

.per-capita {
  color: #c95f2a;
}

.address {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #98a090;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f7f3ec;
  color: #7a6755;
  font-size: 22rpx;
}
