/** app.wxss - 全局样式 **/

page {
  --bg-page: #f4f1ea;
  --bg-surface: #fffdf9;
  --bg-soft: #f7f3ec;
  --text-primary: #1f2520;
  --text-secondary: #667063;
  --text-muted: #98a090;
  --brand: #dd6b2f;
  --brand-strong: #c6541f;
  --brand-soft: #fff1e8;
  --line-soft: rgba(31, 37, 32, 0.08);
  --shadow-card: 0 18rpx 48rpx rgba(73, 52, 35, 0.08);
  --radius-card: 28rpx;
  --radius-pill: 999rpx;
  background:
    radial-gradient(circle at top, rgba(255, 243, 230, 0.92), transparent 38%),
    linear-gradient(180deg, #fbf7f1 0%, #f4f1ea 100%);
  font-family: "Avenir Next", "SF Pro Display", "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

view,
text,
scroll-view,
input,
textarea,
image {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: rgba(255, 253, 249, 0.92);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, #f28c52 100%);
  color: #ffffff;
  border-radius: 22rpx;
  padding: 22rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 16rpx 34rpx rgba(221, 107, 47, 0.22);
}

.btn-primary:active {
  opacity: 0.88;
}

.text-primary {
  color: var(--brand);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-gray {
  color: var(--text-muted);
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}
